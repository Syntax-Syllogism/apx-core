{
  "name": "@syntax-syllogism/apx-core",
  "description": "Shared apx engine: the AEP code generators and dead-code analysis behind the sf apx CLI plugin and the Apx VS Code extension.",
  "version": "0.2.0",
  "author": "Jake Richter <j.p.richter@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Syntax-Syllogism/apx-core#readme",
  "bugs": "https://github.com/Syntax-Syllogism/apx-core/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntax-Syllogism/apx-core.git"
  },
  "keywords": [
    "salesforce",
    "sf",
    "sfdx",
    "apex",
    "apex enterprise patterns",
    "fflib",
    "at4dx",
    "code generation",
    "dead code"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/lib",
    "/CHANGELOG.md",
    "/LICENSE"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf lib",
    "lint": "eslint src test",
    "format": "prettier --write \"+(src|test|scripts)/**/*.+(ts|js|mjs|json)\"",
    "format:check": "prettier --check \"+(src|test|scripts)/**/*.+(ts|js|mjs|json)\"",
    "typecheck": "tsc -p . --noEmit && tsc -p test --noEmit",
    "test:only": "TS_NODE_PROJECT=test/tsconfig.json mocha \"test/**/*.test.ts\"",
    "test": "npm run typecheck && npm run lint && npm run format:check && c8 npm run test:only",
    "pack:check": "node scripts/check-pack.mjs",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@salesforce/core": "^8",
    "zod": "^4",
    "eta": "^4.1.0",
    "pluralize": "^8"
  },
  "devDependencies": {
    "@salesforce/dev-config": "^4.1.0",
    "@salesforce/prettier-config": "^0.0.4",
    "@types/chai": "^4.3.14",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22",
    "@types/sinon": "^10.0.20",
    "c8": "^11.0.0",
    "chai": "^4.3.10",
    "eslint": "^8.57.0",
    "eslint-config-salesforce-typescript": "^3.3.0",
    "mocha": "^10.4.0",
    "prettier": "^2.8.8",
    "sinon": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "@types/pluralize": "^0.0.33"
  }
}
